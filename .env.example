GEMINI_API_KEY=""

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Timezone for Deadline & Calendar Calculations
DEFAULT_TIMEZONE="Asia/Kolkata"

